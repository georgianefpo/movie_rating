# Copie para .env e ajuste conforme sua maquina.

# Conexao com o Postgres (role dev "filmes" e SUPERUSER, criada so para dev local).
# No Windows, o Postgres roda dentro do WSL2 e responde em localhost:5432.
DATABASE_URL=postgres://filmes:filmes@localhost:5432/movie_rating

# Pasta onde estao os arquivos do MovieLens 1M (movies.dat, users.dat, ratings.dat).
# Os .dat NAO ficam no repositorio (licenca GroupLens) — aponte para o local deles.
DATA_DIR=D:/Curso - Engenharia de Sofware em IA Aplicada/PRATICAS/FILMES_AVALIADOS
